{
  "title": "Drive — Overview",
  "uid": "drive-overview",
  "tags": ["drive", "sahla"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active items",
      "datasource": "${datasource}",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "drive_items_total", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active users",
      "datasource": "${datasource}",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "drive_users_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Audit events",
      "datasource": "${datasource}",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "drive_audit_events_total", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active legal holds",
      "datasource": "${datasource}",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "drive_legal_holds_active_total", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Celery queue length",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        { "expr": "drive_celery_queue_length{queue=\"celery\"}", "refId": "A" }
      ]
    }
  ]
}
